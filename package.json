{
  "name": "krishnas_wardrobe",
  "version": "0.0.1",
  "description": "Krishna's wardrobe",
  "node": "20.16.0",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write .",
    "start": " npx cross-env NODE_ENV=prod node dist/main",
    "dev": "npx cross-env NODE_ENV=dev nest start --watch",
    "start:stage": "npx cross-env NODE_ENV=stage node dist/main",
    "start:debug": "npx cross-env NODE_ENV=dev nest start --debug --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prepare": "husky install",
    "check-types": "tsc --pretty --noEmit",
    "check-format": "prettier --check .",
    "check-lint": "eslint . --ext ts --ext js",
    "mig:create": "npx ts-node scripts/createMigration.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "@nest-middlewares/morgan": "^10.0.0",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^11.0.9",
    "@nestjs/core": "^11.0.9",
    "@nestjs/mapped-types": "*",
    "@nestjs/platform-express": "^11.0.9",
    "@nestjs/platform-fastify": "^11.0.9",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/sequelize": "^10.0.1",
    "@nestjs/serve-static": "^4.0.2",
    "axios": "^1.7.7",
    "bcrypt": "^5.1.1",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "firebase-admin": "^12.6.0",
    "jose": "^5.6.3",
    "json2csv": "^6.0.0-alpha.2",
    "moment": "^2.30.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pg": "^8.13.1",
    "puppeteer": "^23.4.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.1",
    "sequelize": "^6.37.5",
    "sequelize-typescript": "^2.1.6",
    "umzug": "^3.8.2",
    "xlsx": "^0.18.5",
    "yup": "^1.4.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.2.2",
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/config": "^3.3.4",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/multer": "^1.4.11",
    "@types/multer-s3": "^3.0.3",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@types/umzug": "^2.3.9",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "husky": "^8.0.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "sequelize-cli": "^6.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "@constants": "<rootDir>/constants/index",
      "@decorators": "<rootDir>/common/decorators/index",
      "@filters": "<rootDir>/common/filters/index",
      "@guards": "<rootDir>/common/guards/index",
      "@interceptors": "<rootDir>/common/interceptors/index",
      "@middlewares": "<rootDir>/common/middlewares/index",
      "@pipes": "<rootDir>/common/pipes/index",
      "@templates": "<rootDir>/common/templates/index",
      "@controllers": "<rootDir>/controllers/index",
      "@modules": "<rootDir>/modules/index",
      "@dtos": "<rootDir>/dtos/index",
      "@models": "<rootDir>/models/index",
      "@queries": "<rootDir>/queries/index",
      "@utils": "<rootDir>/utils/index",
      "@validators": "<rootDir>/validators/index",
      "@libs": "<rootDir>/libs/index",
      "@config": "<rootDir>/config/env"
    }
  }
}
